{
  "name": "mcp-face-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && vite build",
    "start": "node dist/server/index.js",
    "mcp": "node dist/mcp/index.js",
    "doctor": "node scripts/doctor.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm test && npm run test:e2e",
    "workshop:starter": "node scripts/create-starter.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "zod": "4.6.7"
  }
}
